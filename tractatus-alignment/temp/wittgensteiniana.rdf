  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/698">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/698-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/698-ogden"/>
