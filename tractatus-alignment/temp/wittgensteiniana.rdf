    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/892-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/892-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/891"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/truth-operation-by-wittgenstein"/>
    <schema:name>5.5151</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/868">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/868-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/868-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/868-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/867"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/truth-operation-by-wittgenstein"/>
    <schema:name>5.461</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">342</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/801-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/801"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">If the truth-grounds which are common to a number of propositions are all also truth-grounds of some one proposition, we say that the truth of this proposition follows from the truth of those propositions.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/topic/eternal-life-concept-g642969">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <schema:description>Being immortal or having a soul that survives death solves nothing: it just extends the limits of our world and life. What we are really looking for is a way of  transcending them, but this is precluded to us.</schema:description>
    <schema:inDefinedTermSet rdf:resource="http://wittgensteiniana.michelepasin.org/id/topics"/>
    <schema:name>Eternal Life</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/696">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
