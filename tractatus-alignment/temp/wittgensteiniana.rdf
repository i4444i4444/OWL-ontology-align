  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/topic/prop-aesthetics-concept-g624125">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <schema:description>According to Wittgenstein, the propositions of aesthetics, as well as the propositions of ethics, cannot be put into words because they make judgements of value. Therefore, they are clearly nonsensical</schema:description>
    <schema:inDefinedTermSet rdf:resource="http://wittgensteiniana.michelepasin.org/id/topics"/>
    <schema:name>Propositions of Aesthetics</schema:name>
  </rdf:Description>
