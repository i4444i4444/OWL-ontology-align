    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/picture-by-wittgenstein"/>
    <schema:name>2.11</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">51</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/728">
