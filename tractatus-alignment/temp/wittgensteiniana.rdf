    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/696-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/692"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/language-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/logical-form-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein"/>
