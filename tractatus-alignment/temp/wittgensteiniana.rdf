    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/968-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/968-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/968-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/966"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/prop-of-logic-concept-g394004"/>
    <schema:name>6.1222</schema:name>
