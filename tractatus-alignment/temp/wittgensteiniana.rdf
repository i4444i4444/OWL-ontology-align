  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/680-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/680"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">We can, for example, express what is common to all notations for the truth-functions as follows: It is common to them that they all, for example, can be replaced by the notations of “~ p” (“not p”) and “p  ∨  q” (“p or q”). (Herewith is indicated the way in which a special possible notation can give us general information.)</schema:text>
  </rdf:Description>
