    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/sense-of-the-proposition-by-wittgenstein"/>
    <schema:name>3.203</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">111</schema:position>
  </rdf:Description>
