  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/topic/essence-of-things-concept-g343950">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <schema:description>The essence of things, or essence of an object, is its possibility of constituting states of affairs.</schema:description>
    <schema:inDefinedTermSet rdf:resource="http://wittgensteiniana.michelepasin.org/id/topics"/>
    <schema:name>Essence of Things</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/923">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
