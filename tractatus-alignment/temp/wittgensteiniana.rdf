    <schema:text xml:lang="en">That is how a picture is attached to reality; it reaches right out to it.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/940-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
