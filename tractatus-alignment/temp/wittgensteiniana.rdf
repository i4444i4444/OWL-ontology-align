  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/784">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/784-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/784-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/784-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/783"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein"/>
    <schema:name>4.461</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">258</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/797-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/797"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">The elementary propositions are the truth-arguments of propositions.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/967-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/967"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Ergeben z.&amp;nbsp;B. zwei Sätze „p“ und „q“ in der Verbindung „p  ⊃  q“ eine Tautologie, so ist klar, dass q aus p folgt. Dass z.&amp;nbsp;B. „q“ aus „p  ⊃  q . p“ folgt, ersehen wir aus diesen beiden Sätzen selbst, aber wir können es auch so zeigen, indem wir sie zu „p  ⊃  q . p :⊃: q“ verbinden und nun zeigen, dass dies eine Tautologie ist.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/topic/reality-by-wittgenstein">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <schema:description>Wittgenstein does not say in so many words that a true proposition is one that corresponds with the facts, but he does say that a proposition is a picture of reality, that a picture either agrees or disagrees with reality, and that truth consists in the agreement of its 'sense' with reality. These propositions, it will be noticed, speak of an agreement with 'reality', but Wittgenstein says that the world is the sum total of reality, thus linking these propositions with his earlier assertion that the world is the totality of facts.</schema:description>
    <schema:inDefinedTermSet rdf:resource="http://wittgensteiniana.michelepasin.org/id/topics"/>
    <schema:name>Reality</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/983">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/983-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/983-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/983-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/978"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/prop-of-logic-concept-g394004"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/role-of-logic-by-wittgenstein"/>
    <schema:name>6.1265</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">457</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/571-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/571"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">The totality of existing states of affairs also determines which states of affairs do not exist.</schema:text>
  </rdf:Description>
