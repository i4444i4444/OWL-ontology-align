    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/551-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/551-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/551-pears"/>
