  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/topic/negation-operation-concept-g385707">
    <rdf:type rdf:resource="https://schema.org/DefinedTerm"/>
    <schema:description>The negation operation is the one by which all propositions can be derived from the elementary ones. Accordingly, the general propositional form shows the way the negation operation should be employed for such purposes.</schema:description>
    <schema:inDefinedTermSet rdf:resource="http://wittgensteiniana.michelepasin.org/id/topics"/>
    <schema:name>Negation Operation</schema:name>
  </rdf:Description>
