    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/necessary-concept-g595859"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/prop-of-logic-concept-g394004"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/role-of-logic-by-wittgenstein"/>
