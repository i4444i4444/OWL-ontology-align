    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/611-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/611-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/607"/>
