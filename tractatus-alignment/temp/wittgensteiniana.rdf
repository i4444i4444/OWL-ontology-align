  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/1000-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/1000"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Das Wesentliche der mathematischen Methode ist es, mit Gleichungen zu arbeiten. Auf dieser Methode beruht es nämlich, dass jeder Satz der Mathematik sich von selbst verstehen muss.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/992-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/992"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Es ist eine Eigenschaft der Bejahung, dass man sie als doppelte Verneinung auffassen kann. Es ist eine Eigenschaft von „1+1+1+1“, dass man es als „(1+1)+(1+1)“ auffassen kann.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/859-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/859"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Dieses Verschwinden der scheinbaren logischen Konstanten tritt auch ein, wenn „~ (∃ x). ~ fx“ dasselbe sagt wie „(x). fx“, oder „(∃ x). fx . x = a“ dasselbe wie „fa“.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/938-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/938"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">The world and life are one.</schema:text>
  </rdf:Description>
