    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/879-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/879-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/870"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/symbol-by-wittgenstein"/>
    <schema:name>5.474</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">353</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/934">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/934-german"/>
