  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/666-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/666"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">A sign does not determine a logical form unless it is taken together with its logico-syntactical employment.</schema:text>
  </rdf:Description>
