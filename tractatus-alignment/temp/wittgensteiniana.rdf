  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/656-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/656"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">What values the propositional variable can assume is determined. The determination of the values is the variable.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/611-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/611"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">It is impossible to tell from the picture alone whether it is true or false.</schema:text>
  </rdf:Description>
