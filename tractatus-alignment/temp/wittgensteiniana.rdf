    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/propositional-attitude-by-wittgenstein"/>
    <schema:name>5.541</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">389</schema:position>
