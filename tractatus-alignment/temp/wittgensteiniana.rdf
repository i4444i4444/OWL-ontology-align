  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/665-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/665"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">In order to recognize the symbol in the sign we must consider the significant use.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/672-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/672"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">The rules of logical syntax must go without saying, once we know how each individual sign signifies.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/948">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/948-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/948-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/948-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/947"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/general-propositional-form-by-wittgenstein"/>
    <schema:name>6.001</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">422</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/1007-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/1007"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Man hat ja auch davon eine Ahnung gehabt, dass es ein „Gesetz der kleinsten Wirkung“ geben müsse, ehe man genau wusste, wie es lautete. (Hier, wie immer, stellt sich das a priori Gewisse als etwas rein Logisches heraus.)</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/633-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/633"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">Situations can be described but not given names. (Names are like points; propositions like arrows—they have sense.)</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/1015">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/1015-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/1015-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/1015-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/1003"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/natural-science-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/prop-of-science-concept-g558368"/>
    <schema:name>6.35</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">489</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/652-ogden">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/652"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/ogden"/>
    <schema:text xml:lang="en">It is therefore represented by the general form of the propositions which it characterizes. And in this form the expression is constant and everything else variable.</schema:text>
  </rdf:Description>
