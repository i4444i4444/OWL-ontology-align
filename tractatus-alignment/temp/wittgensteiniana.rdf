    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/1021"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/natural-science-by-wittgenstein"/>
    <schema:name>6.3631</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">496</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/774">
