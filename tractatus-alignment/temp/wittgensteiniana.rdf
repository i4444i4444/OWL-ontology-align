    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">408</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/895-pears">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/895"/>
    <schema:inLanguage>en</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/expression/pears"/>
    <schema:text xml:lang="en">What is peculiar to the generality-sign is first, that it indicates a logical prototype, and secondly, that it gives prominence to constants.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/920">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/920-german"/>
