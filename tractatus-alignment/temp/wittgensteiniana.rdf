  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/761">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/Thesis"/>
    <rdf:type rdf:resource="https://schema.org/Chapter"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/761-german"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/761-ogden"/>
    <ex:hasTextFragment rdf:resource="http://wittgensteiniana.michelepasin.org/id/fragment/761-pears"/>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/760"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/analysis-of-a-proposition-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/elementary-proposition-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/state-of-affairs-by-wittgenstein"/>
    <schema:mentions rdf:resource="http://wittgensteiniana.michelepasin.org/id/topic/world-by-wittgenstein"/>
    <schema:name>4.2211</schema:name>
    <schema:position rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">235</schema:position>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/fragment/720-german">
    <rdf:type rdf:resource="http://example.org/wittgensteiniana/TextFragment"/>
    <rdf:type rdf:resource="https://schema.org/CreativeWork"/>
    <schema:exampleOfWork rdf:resource="http://wittgensteiniana.michelepasin.org/id/unit/720"/>
    <schema:inLanguage>de</schema:inLanguage>
    <schema:isPartOf rdf:resource="http://wittgensteiniana.michelepasin.org/id/tractatus"/>
    <schema:text xml:lang="de">Kann man sich nicht mit falschen Sätzen, wie bisher mit wahren, verständigen? Solange man nur weiß, dass sie falsch gemeint sind. Nein! Denn, wahr ist ein Satz, wenn es sich so verhält, wie wir es durch ihn sagen; und wenn wir mit „p“ ~ p meinen, und es sich so verhält wie wir es meinen, so ist „p“ in der neuen Auffassung wahr und nicht falsch.</schema:text>
  </rdf:Description>
  <rdf:Description rdf:about="http://wittgensteiniana.michelepasin.org/id/unit/972">
