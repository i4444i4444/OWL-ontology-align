@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix inst: <http://purl.org/wittgensteinsource/ont/instances/> .
@prefix ns1: <http://purl.org/wittgensteinsource/ont/scholar/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wab: <http://purl.org/wittgensteinsource/ont/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wab:Bemerkung a rdfs:Class ;
    rdfs:label "Nachlass Bemerkung"^^xsd:string ;
    rdfs:comment """Bemerkung, subclass of Wittgenstein Primary source: Corresponding roughly to a
            single remark in a Wittgenstein primary source, identified by the
            Wittgenstein Archives through a “siglum” which is composed of item identifier, page
            identifier(s) and position identifier(s). Example of instance: Ts-310,21[2]et22[1]
        """^^xsd:string ;
    rdfs:subClassOf wab:WittgensteinSource .

wab:Part a rdfs:Class ;
    rdfs:label "Part"^^xsd:string ;
    rdfs:comment "Part"^^xsd:string ;
    rdfs:subClassOf wab:WittgensteinSource .

wab:TS a rdfs:Class ;
    rdfs:label "TS"^^xsd:string ;
    rdfs:comment "TS, subclass of Wittgenstein Primary source: A Wittgenstein primary source, typed. Example of instance: Ts-213; Ts-310 "^^xsd:string ;
    rdfs:subClassOf wab:WittgensteinSource .

wab:Werk a rdfs:Class ;
    rdfs:label "Work"^^xsd:string ;
    rdfs:comment """Work, subclass of Wittgenstein Primary Source: A publication of a Wittgenstein
            primary source / of a selection from Wittgenstein primary sources which has become standard and is known as a "work by Wittgenstein". Example of instance: Philosophical Investigations; Culture and Value
        """^^xsd:string ;
    rdfs:subClassOf wab:WittgensteinSource .

wab:contains a owl:ObjectProperty ;
    rdfs:label "contains"^^xsd:string ;
    rdfs:domain wab:WittgensteinSource ;
    rdfs:range ns1:TextSubGenre .

wab:hasFacsView a owl:DatatypeProperty ;
    rdfs:label "has facs view"^^xsd:string ;
    rdfs:comment """<p style="margin-top: 0">\r
      Is used to point at a wittgensteinsource facs view URI."""^^xsd:string ;
    rdfs:domain ns1:Source ;
    rdfs:range xsd:string .

wab:hasPart a owl:ObjectProperty ;
    rdfs:label "hasPart"^^xsd:string ;
    rdfs:comment "hasPart"^^xsd:string ;
    rdfs:domain wab:WittgensteinSource .

